@echo off
setlocal
set "SOBS_INSTALLER=%~f0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $installer=$env:SOBS_INSTALLER; $raw=[IO.File]::ReadAllText($installer); $marker='###SOBS_BSB_PAYLOAD###'; $markerIndex=$raw.LastIndexOf($marker); $payload=$raw.Substring($markerIndex+$marker.Length).Trim(); $bytes=[Convert]::FromBase64String($payload); $token=[guid]::NewGuid().ToString('N'); $zip=Join-Path $env:TEMP ('SOBS-BSB-'+$token+'.zip'); $stage=Join-Path $env:TEMP ('SOBS-BSB-'+$token); [IO.File]::WriteAllBytes($zip,$bytes); Add-Type -AssemblyName System.IO.Compression.FileSystem; [IO.Compression.ZipFile]::ExtractToDirectory($zip,$stage); $install=Join-Path $env:LOCALAPPDATA 'SOBS BSB'; New-Item -ItemType Directory -Path $install -Force | Out-Null; Get-ChildItem -LiteralPath $stage -File | Copy-Item -Destination $install -Force; $uninstallKey='HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\SOBS-BSB'; New-Item -Path $uninstallKey -Force | Out-Null; $q=[char]34; $uninstallCommand='powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File '+$q+(Join-Path $install 'Uninstall-SOBS-BSB.ps1')+$q; Set-ItemProperty -Path $uninstallKey -Name DisplayName -Value 'SOBS BSB v2'; Set-ItemProperty -Path $uninstallKey -Name DisplayVersion -Value '2.0'; Set-ItemProperty -Path $uninstallKey -Name Publisher -Value 'S.O.B.S.'; Set-ItemProperty -Path $uninstallKey -Name InstallLocation -Value $install; Set-ItemProperty -Path $uninstallKey -Name DisplayIcon -Value (Join-Path $install 'SOBS-BSB.ico'); Set-ItemProperty -Path $uninstallKey -Name UninstallString -Value $uninstallCommand; Set-ItemProperty -Path $uninstallKey -Name NoModify -Value 1 -Type DWord; Set-ItemProperty -Path $uninstallKey -Name NoRepair -Value 1 -Type DWord; $desktop=[Environment]::GetFolderPath('DesktopDirectory'); $shell=New-Object -ComObject WScript.Shell; $shortcut=$shell.CreateShortcut((Join-Path $desktop 'SOBS.lnk')); $shortcut.TargetPath=Join-Path $install 'SOBS BSB.html'; $shortcut.WorkingDirectory=$install; $shortcut.IconLocation=(Join-Path $install 'SOBS-BSB.ico')+',0'; $shortcut.Description='SOBS BSB v2'; $shortcut.Save(); Remove-Item -LiteralPath $zip -Force; Remove-Item -LiteralPath $stage -Recurse -Force; Start-Process -FilePath $shortcut.TargetPath"
if errorlevel 1 (
  echo SOBS BSB could not be installed. Please try again or contact SOBS support.
  pause
  exit /b 1
)
exit /b 0
###SOBS_BSB_PAYLOAD###

